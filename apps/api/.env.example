# Server
PORT=1000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/allmap_hostels?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/allmap_hostels?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/allmap_hostels?schema=public

# Frontend Application URLs
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
SUPA_ADMIN_URL=http://localhost:3002

# Authentication
JWT_SECRET=your_jwt_secret_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:1000/auth/google/callback

# Payments (Paystack)
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail / Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@allmaphostels.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# External APIs
LAND_API_KEY=
SERPAPI_KEY=
